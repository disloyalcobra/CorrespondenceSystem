// Modelo relacional de referencia para SegOfi.
// El esquema es independiente de ORM/DBMS y deberá implementarse en el backend elegido.

Table roles {
  id int [pk, increment]
  nombre varchar
}

Table departamentos {
  id int [pk, increment]
  nombre varchar
  tipo varchar
}

Table tipos_documento {
  id int [pk, increment]
  nombre varchar
}

Table estados {
  id int [pk, increment]
  nombre varchar
  orden int
}

Table usuarios {
  id int [pk, increment]
  nombre varchar
  email varchar
  password_hash varchar
  rol_id int
  departamento_id int
  activo boolean
}

Table oficios {
  id int [pk, increment]
  folio varchar [unique]
  tipo_documento_id int
  objeto text
  asunto varchar
  destinatario varchar [note: 'Texto libre para documentos externos; el enrutamiento usa el departamento destino']
  fecha_documento date
  fecha_recepcion datetime
  termino date
  remitente_usuario_id int
  origen_usuario_id int
  departamento_destino_inicial_id int
  estado_id int
  creado_en datetime
}

Table adjuntos {
  id int [pk, increment]
  entidad_tipo varchar [note: 'OFICIO o SEGUIMIENTO']
  entidad_id int
  nombre_archivo varchar
  archivo_url varchar
  creado_en datetime
}

Table oficio_turnos {
  id int [pk, increment]
  oficio_id int
  departamento_id int
  turnado_por_usuario_id int
  turnado_en datetime
  recibido_en datetime
}

Table oficio_seguimiento {
  id int [pk, increment]
  oficio_id int
  usuario_id int
  tipo varchar
  contenido text
  creado_en datetime
}

Table oficio_lecturas {
  id int [pk, increment]
  oficio_id int
  usuario_id int
  leido_en datetime
}

Table oficios_salidas {
  id int [pk, increment]
  folio varchar [unique, note: 'Formato SAL-AAAA-XXXX']
  oficio_id int [unique]
  enviado_por_usuario_id int
  enviado_en datetime
}

Table auditoria {
  id int [pk, increment]
  usuario_id int
  accion varchar
  entidad varchar
  entidad_id int
  detalle text
  creado_en datetime
}

Ref: usuarios.rol_id > roles.id
Ref: usuarios.departamento_id > departamentos.id
Ref: oficios.tipo_documento_id > tipos_documento.id
Ref: oficios.estado_id > estados.id
Ref: oficios.remitente_usuario_id > usuarios.id
Ref: oficios.origen_usuario_id > usuarios.id
Ref: oficios.departamento_destino_inicial_id > departamentos.id
Ref: oficio_turnos.oficio_id > oficios.id
Ref: oficio_turnos.departamento_id > departamentos.id
Ref: oficio_turnos.turnado_por_usuario_id > usuarios.id
Ref: oficio_seguimiento.oficio_id > oficios.id
Ref: oficio_seguimiento.usuario_id > usuarios.id
Ref: oficio_lecturas.oficio_id > oficios.id
Ref: oficio_lecturas.usuario_id > usuarios.id
Ref: oficios_salidas.oficio_id > oficios.id
Ref: oficios_salidas.enviado_por_usuario_id > usuarios.id
Ref: auditoria.usuario_id > usuarios.id
